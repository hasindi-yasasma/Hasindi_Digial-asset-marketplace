# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (Vercel & Live Testnet / Mainnet)
# ==============================================================================

# 1. Server-side Ethereum JSON-RPC Provider (Used by Vercel Serverless API Routes)
# Sepolia: https://ethereum-sepolia-rpc.publicnode.com
# Mainnet: https://mainnet.infura.io/v3/YOUR_INFURA_KEY
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 2. Public Client-side RPC & Chain ID (Sepolia = 11155111, Mainnet = 1)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CHAIN_ID=11155111

# 3. Base API Path
NEXT_PUBLIC_API_URL=/api

# 4. Optional Deployer Private Key
# PRIVATE_KEY=0x_your_private_key_here

